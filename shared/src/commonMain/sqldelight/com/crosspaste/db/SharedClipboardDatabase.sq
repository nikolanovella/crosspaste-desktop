import kotlin.Boolean;

-- Membership setup explicitly activates a workspace. An empty table captures nothing.
CREATE TABLE SharedClipboardWorkspaceEntity (
    clipboardId TEXT PRIMARY KEY NOT NULL,
    enabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    contributeLocal INTEGER AS Boolean NOT NULL DEFAULT 0
);

-- Immutable capture metadata survives history dedup/deletion while signing is pending.
-- File bytes still require payload retention before this queue is enabled in production.
CREATE TABLE SharedClipboardCaptureEntity (
    clipboardId TEXT NOT NULL,
    localPasteId INTEGER NOT NULL,
    originDevice TEXT NOT NULL,
    pasteAppearItem TEXT NOT NULL,
    pasteCollection TEXT NOT NULL,
    pasteType INTEGER NOT NULL,
    source TEXT,
    size INTEGER NOT NULL,
    hash TEXT NOT NULL,
    createTime INTEGER NOT NULL,
    PRIMARY KEY (clipboardId, localPasteId)
);

CREATE TABLE SharedClipboardEventEntity (
    clipboardId TEXT NOT NULL,
    originDevice TEXT NOT NULL,
    originSequence INTEGER NOT NULL,
    lamportClock INTEGER NOT NULL,
    entryId TEXT NOT NULL,
    signedChange TEXT NOT NULL,
    PRIMARY KEY (clipboardId, originDevice, originSequence)
);

CREATE INDEX SharedClipboardEventOrder ON SharedClipboardEventEntity
    (clipboardId, lamportClock, originDevice, originSequence);

CREATE TABLE SharedClipboardPayloadEntity (
    clipboardId TEXT NOT NULL,
    contentHash TEXT NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY (clipboardId, contentHash)
);

-- References outlive the capture queue: normal history cleanup cannot erase shared file bytes.
CREATE TABLE SharedClipboardRetentionEntity (
    clipboardId TEXT NOT NULL,
    localPasteId INTEGER NOT NULL,
    PRIMARY KEY (clipboardId, localPasteId)
);

CREATE INDEX SharedClipboardRetentionPaste ON SharedClipboardRetentionEntity(localPasteId);

CREATE TRIGGER SharedClipboardCaptureRetain AFTER INSERT ON SharedClipboardCaptureEntity BEGIN
    INSERT OR IGNORE INTO SharedClipboardRetentionEntity(clipboardId, localPasteId)
    VALUES (new.clipboardId, new.localPasteId);
END;

CREATE TABLE SharedClipboardMemberEntity (
    clipboardId TEXT NOT NULL,
    deviceId TEXT NOT NULL,
    signingPublicKey TEXT NOT NULL,
    PRIMARY KEY (clipboardId, deviceId)
);

-- A stable event-to-history mapping prevents reconnects from duplicating UI rows.
CREATE TABLE SharedClipboardProjectionEntity (
    clipboardId TEXT NOT NULL,
    eventDevice TEXT NOT NULL,
    eventSequence INTEGER NOT NULL,
    entryId TEXT NOT NULL,
    contentHash TEXT NOT NULL,
    localPasteId INTEGER NOT NULL,
    needsRender INTEGER AS Boolean NOT NULL DEFAULT 1,
    PRIMARY KEY (clipboardId, eventDevice, eventSequence)
);

CREATE TABLE SharedClipboardAdmissionEntity (
    clipboardId TEXT NOT NULL,
    deviceId TEXT NOT NULL,
    proof TEXT NOT NULL,
    PRIMARY KEY (clipboardId, deviceId)
);

CREATE TABLE SharedClipboardNativeIdentityEntity (
    originDevice TEXT NOT NULL,
    originPasteId INTEGER NOT NULL,
    metadataHash TEXT NOT NULL,
    contentHash TEXT NOT NULL,
    localPasteId INTEGER NOT NULL,
    authorVerified INTEGER NOT NULL DEFAULT 0,
    identityVersion INTEGER NOT NULL DEFAULT 1,
    nativeSnapshot TEXT,
    PRIMARY KEY (originDevice, originPasteId, metadataHash)
);

CREATE INDEX SharedClipboardNativeIdentityPaste ON SharedClipboardNativeIdentityEntity(localPasteId);

CREATE INDEX SharedClipboardCapturePaste ON SharedClipboardCaptureEntity(localPasteId);

CREATE TABLE SharedClipboardFileReceiptEntity (
    localPasteId INTEGER PRIMARY KEY NOT NULL,
    identity TEXT NOT NULL
);

CREATE INDEX SharedClipboardEventCapture ON SharedClipboardEventEntity(clipboardId, originDevice, entryId);

CREATE TRIGGER SharedClipboardFileReceiptDelete AFTER DELETE ON PasteDataEntity BEGIN
    DELETE FROM SharedClipboardFileReceiptEntity WHERE localPasteId = old.id;
END;

putWorkspace:
INSERT OR REPLACE INTO SharedClipboardWorkspaceEntity(clipboardId, enabled, contributeLocal)
VALUES (?, ?, ?);

enqueueLoadedLocalCapture:
INSERT OR IGNORE INTO SharedClipboardCaptureEntity
SELECT w.clipboardId, p.id, p.appInstanceId, p.pasteAppearItem, p.pasteCollection,
       p.pasteType, p.source, p.size, p.hash, p.createTime
FROM PasteDataEntity p CROSS JOIN SharedClipboardWorkspaceEntity w
WHERE p.id = :localPasteId AND p.pasteState = 1 AND p.remote = 0
  AND p.pasteAppearItem IS NOT NULL AND p.hash <> ''
  AND w.enabled = 1 AND w.contributeLocal = 1;

getPendingCaptures:
SELECT * FROM SharedClipboardCaptureEntity
WHERE clipboardId = :clipboardId ORDER BY localPasteId ASC LIMIT :batchLimit;

completeCapture:
DELETE FROM SharedClipboardCaptureEntity WHERE clipboardId = ? AND localPasteId = ?;

getWorkspace:
SELECT * FROM SharedClipboardWorkspaceEntity WHERE clipboardId = ?;

getEnabledWorkspaces:
SELECT * FROM SharedClipboardWorkspaceEntity WHERE enabled = 1 ORDER BY clipboardId;

getWorkspaces:
SELECT * FROM SharedClipboardWorkspaceEntity ORDER BY clipboardId;

followRecordingPreference:
UPDATE SharedClipboardWorkspaceEntity SET contributeLocal = :recording
WHERE enabled = 1 AND contributeLocal != :recording;

getCapture:
SELECT * FROM SharedClipboardCaptureEntity WHERE clipboardId = ? AND localPasteId = ?;

getEvents:
SELECT * FROM SharedClipboardEventEntity WHERE clipboardId = ?
ORDER BY lamportClock, originDevice, originSequence;

insertEvent:
INSERT INTO SharedClipboardEventEntity VALUES (?, ?, ?, ?, ?, ?);

getPayload:
SELECT payload FROM SharedClipboardPayloadEntity WHERE clipboardId = ? AND contentHash = ?;

insertPayload:
INSERT INTO SharedClipboardPayloadEntity VALUES (?, ?, ?);

getPayloadCount:
SELECT count(*) FROM SharedClipboardPayloadEntity WHERE clipboardId = ?;

isPasteRetained:
SELECT EXISTS(SELECT 1 FROM SharedClipboardRetentionEntity WHERE localPasteId = ?);

releaseRetention:
DELETE FROM SharedClipboardRetentionEntity WHERE clipboardId = ? AND localPasteId = ?;

getMember:
SELECT * FROM SharedClipboardMemberEntity WHERE clipboardId = ? AND deviceId = ?;

getMembers:
SELECT * FROM SharedClipboardMemberEntity WHERE clipboardId = ? ORDER BY deviceId;

insertMember:
INSERT INTO SharedClipboardMemberEntity VALUES (?, ?, ?);

getProjection:
SELECT * FROM SharedClipboardProjectionEntity WHERE clipboardId = ? AND eventDevice = ? AND eventSequence = ?;

insertProjection:
INSERT INTO SharedClipboardProjectionEntity VALUES (?, ?, ?, ?, ?, ?, 1);

getPendingProjectionRendering:
SELECT * FROM SharedClipboardProjectionEntity WHERE clipboardId = ? AND needsRender = 1 LIMIT ?;

completeProjectionRendering:
UPDATE SharedClipboardProjectionEntity SET needsRender = 0
WHERE clipboardId = ? AND eventDevice = ? AND eventSequence = ?;

retainPaste:
INSERT OR IGNORE INTO SharedClipboardRetentionEntity(clipboardId, localPasteId) VALUES (?, ?);

getAdmission:
SELECT * FROM SharedClipboardAdmissionEntity WHERE clipboardId = ? AND deviceId = ?;

getAdmissions:
SELECT * FROM SharedClipboardAdmissionEntity WHERE clipboardId = ? ORDER BY deviceId;

insertAdmission:
INSERT INTO SharedClipboardAdmissionEntity VALUES (?, ?, ?);

getNativeIdentity:
SELECT * FROM SharedClipboardNativeIdentityEntity WHERE originDevice = ? AND originPasteId = ? AND metadataHash = ?;

getNativeIdentitiesForPaste:
SELECT * FROM SharedClipboardNativeIdentityEntity WHERE localPasteId = ? ORDER BY authorVerified DESC;

putNativeIdentity:
INSERT OR REPLACE INTO SharedClipboardNativeIdentityEntity VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getCapturesForPaste:
SELECT * FROM SharedClipboardCaptureEntity WHERE localPasteId = ?;

putFileReceipt:
INSERT OR REPLACE INTO SharedClipboardFileReceiptEntity VALUES (?, ?);

getFileReceipt:
SELECT identity FROM SharedClipboardFileReceiptEntity WHERE localPasteId = ?;

deleteFileReceipt:
DELETE FROM SharedClipboardFileReceiptEntity WHERE localPasteId = ?;

getCaptureEventSequences:
SELECT originSequence FROM SharedClipboardEventEntity WHERE clipboardId = ? AND originDevice = ? AND entryId = ?
ORDER BY originSequence DESC;
